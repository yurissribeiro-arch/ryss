# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Nunca envie .env.local para o GitHub.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor. Nunca use com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Somente desenvolvimento: exibe produtos de EXEMPLO (claramente identificados)
# enquanto o Supabase não está configurado. Ignorado em produção.
DEMO_PRODUCTS=false
